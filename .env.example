# ==============================================================================
# ExamPlus - Cấu Hình Môi Trường Mẫu (.env.example)
# Sao chép tệp này thành .env và điền các giá trị phù hợp với máy chủ của bạn
# ==============================================================================

# --- 1. Cấu Hình Máy Chủ & Mạng ---
# Cổng lắng nghe mặc định của máy chủ ExamPlus (mặc định: 8080)
PORT=8080

# Địa chỉ IP ràng buộc (0.0.0.0 để cho phép thiết bị cùng mạng LAN truy cập)
HOST=0.0.0.0

# Mức độ ghi nhật ký hệ thống: trace | debug | info | warn | error
RUST_LOG=info

# --- 2. Tích Hợp Google Drive & Google OAuth (Tùy Chọn) ---
# Điền Google OAuth 2.0 Client ID và Client Secret từ Google Cloud Console
# (Tạo ứng dụng loại Desktop hoặc Web Application, thêm redirect URI: http://127.0.0.1:8080/api/v1/auth/google/callback)
# Nếu không cấu hình, bạn vẫn có thể nạp đề thi trực tiếp từ máy tính (Word .docx và PDF).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 3. Công Cụ OCR & Bóc Tách PDF (Tùy Chọn) ---
# Đường dẫn tùy chỉnh tới công cụ pdftoppm (thuộc bộ Poppler) và Tesseract OCR
# (Mặc định ExamPlus sẽ tự động tìm trong PATH hệ thống hoặc thư mục tools/)
EXAMPLUS_PDFTOPPM_PATH=
EXAMPLUS_TESSERACT_PATH=
TESSDATA_PREFIX=
